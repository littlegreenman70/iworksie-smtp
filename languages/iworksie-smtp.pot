msgstr ""

#: src/Support/ErrorTranslator.php:223
msgid "Microsoft 365 has SMTP sign-in switched off"
msgstr ""

#: src/Support/ErrorTranslator.php:224
msgid "Microsoft is retiring password sign-in over SMTP (Basic auth). Most Microsoft 365 tenants now refuse it, even with the right password."
msgstr ""

#: src/Support/ErrorTranslator.php:225
msgid "Choose \"Microsoft 365\" on the Setup tab instead of Other SMTP. It sends through the Microsoft Graph API, which does not need SMTP sign-in."
msgstr ""

#: src/Support/ErrorTranslator.php:231
msgid "Google refused the password"
msgstr ""

#: src/Support/ErrorTranslator.php:232
msgid "Gmail and Google Workspace no longer accept your normal password over SMTP."
msgstr ""

#: src/Support/ErrorTranslator.php:233
msgid "Choose \"Google\" on the Setup tab to connect with Google sign-in instead. If you must use SMTP, create an App Password in your Google account (this needs 2-Step Verification)."
msgstr ""

#: src/Support/ErrorTranslator.php:239
msgid "The SMTP username or password was not accepted"
msgstr ""

#: src/Support/ErrorTranslator.php:240
msgid "The mail server rejected the sign-in details."
msgstr ""

#: src/Support/ErrorTranslator.php:241
msgid "Re-enter the SMTP username (usually the full email address, or the API key name your provider gives you) and the password or API key. Check there are no spaces before or after."
msgstr ""

#: src/Support/ErrorTranslator.php:247
msgid "The mail server's security certificate was not trusted"
msgstr ""

#: src/Support/ErrorTranslator.php:248
msgid "The secure connection failed because the server's certificate does not match the host name, has expired, or your web server's certificate list is out of date."
msgstr ""

#: src/Support/ErrorTranslator.php:249
msgid "Use the exact host name your provider documents (for example smtp.provider.com rather than an IP address or mail.yourdomain.com). If that is correct, ask your host to update the server's CA certificates."
msgstr ""

#: src/Support/ErrorTranslator.php:255
msgid "Could not connect to the mail server"
msgstr ""

#: src/Support/ErrorTranslator.php:256
msgid "Your web server could not open a connection to the SMTP host. The host name may be wrong, or (very often) your hosting company blocks outgoing mail ports such as 25, 465 and 587."
msgstr ""

#: src/Support/ErrorTranslator.php:257
msgid "Check the host and port. Try port 587 with TLS, then 465 with SSL. If neither connects, ask your host whether outgoing SMTP is blocked, or use Microsoft 365 / Google, which send over normal HTTPS."
msgstr ""

#: src/Support/ErrorTranslator.php:263
msgid "The server requires encryption"
msgstr ""

#: src/Support/ErrorTranslator.php:264
msgid "The mail server will only accept a sign-in over an encrypted connection."
msgstr ""

#: src/Support/ErrorTranslator.php:265
msgid "Set Encryption to TLS (port 587) or SSL (port 465) on the Setup tab."
msgstr ""

#: src/Support/ErrorTranslator.php:271
msgid "The server refused the From address"
msgstr ""

#: src/Support/ErrorTranslator.php:272
msgid "The mail server will not send email from this From address with these sign-in details, usually because the address belongs to a different account or an unverified domain."
msgstr ""

#: src/Support/ErrorTranslator.php:273
msgid "Set the From address to the account you sign in with, or verify your domain / sender with your email provider. Keep \"Force From address\" switched on."
msgstr ""

#: src/Support/ErrorTranslator.php:279
msgid "This server cannot send email by itself"
msgstr ""

#: src/Support/ErrorTranslator.php:280
msgid "WordPress is using PHP's built-in mail function and your host has disabled it or it is not configured."
msgstr ""

#: src/Support/ErrorTranslator.php:281
msgid "Choose Microsoft 365, Google or Other SMTP on the Setup tab so email goes through a real mail service."
msgstr ""

#: src/Support/ErrorTranslator.php:287
msgid "The website could not reach the mail service"
msgstr ""

#: src/Support/ErrorTranslator.php:288
msgid "The HTTPS request to Microsoft or Google timed out or could not be made. Your host may block outgoing connections or have a DNS problem."
msgstr ""

#: src/Support/ErrorTranslator.php:289
msgid "Try again in a minute. If it keeps happening, ask your host to allow outgoing HTTPS to graph.microsoft.com / login.microsoftonline.com or gmail.googleapis.com / oauth2.googleapis.com."
msgstr ""

#: src/Support/ErrorTranslator.php:295
msgid "An email address is not valid"
msgstr ""

#: src/Support/ErrorTranslator.php:296
msgid "The To, From or Reply-To address is empty or not a valid email address."
msgstr ""

#: src/Support/ErrorTranslator.php:297
msgid "Check the From address on the Setup tab and the recipient address used by the form or plugin that sent this email."
msgstr ""
